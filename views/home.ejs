<% layout('/layouts/boilerplate') %>

    <div class="container-fluid p-0 position-relative mb-5">
        <img class="hero-img" src="/images/header.jpg" alt="">

        <div class="overlay"></div>
        <div class="hero-text">
            <h1 class="fw-bold fs-1">OLCA Dent</h1>
            <h1 class="fw-bold fs-1">Clinica Odontologica</h1>
        </div>

    </div>

    <div class="container text-center mt-5 mb-5 py-5">
        <h1 class="mb-5">Servicios Odontológicos</h1>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <img src="/images/ortodoncia.png" class="card-img-top card-img" alt="">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Tratamiento de ortodoncia</h5>
                        <p class="card-text flex-grow-1">
                            Corrige la alineación dental y mejora la mordida.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <img src="/images/endodoncia.jpg" class="card-img-top card-img" alt="">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Tratamiento de endodoncia</h5>
                        <p class="card-text flex-grow-1">
                            Eliminación de infección y preservación del diente.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <img src="/images/extraccion.jpg" class="card-img-top card-img" alt="">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Extracción de muelas</h5>
                        <p class="card-text flex-grow-1">
                            Procedimiento seguro y profesional.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <img src="/images/limpieza.jpg" class="card-img-top card-img" alt="">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Limpieza e Higiene Bucodental</h5>
                        <p class="card-text flex-grow-1">
                            Prevención y cuidado integral.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <img src="/images/protesis.jpg" class="card-img-top card-img" alt="">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Prótesis Dental</h5>
                        <p class="card-text flex-grow-1">
                            Restauración estética y funcional.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>