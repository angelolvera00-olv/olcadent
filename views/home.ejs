<% layout('/layouts/boilerplate') %>

    <div class="container-fluid p-0 position-relative mb-5">
        <img class="hero-img" src="/images/header.jpg" alt="">

        <div class="overlay"></div>
        <div class="hero-text">
            <h1 class="fw-bold fs-1">OLCA Dent</h1>
            <h1 class="fw-bold fs-1">Clinica Odontologica</h1>
        </div>

    </div>

    <div class="container text-center mt-5 mb-5 py-5">
        <h1 class="mb-5">Servicios Odontológicos</h1>

        <div class="row g-4">

            <% servicios.forEach(servicio=> { %>

                <div class="col-md-4">
                    <a href="/servicios/<%= servicio.slug %>" class="text-decoration-none text-dark">
                        <div class="card h-100 shadow-sm">
                            <img src="<%= servicio.imagen %>" class="card-img-top card-img" alt="">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">
                                    <%= servicio.titulo %>
                                </h5>
                                <p class="card-text flex-grow-1">
                                    <%= servicio.descripcion %>
                                </p>
                            </div>
                        </div>
                    </a>
                </div>

                <% }) %>
        </div>
    </div>

    <section class="container-fluid mt-5 p-0">
        <h2 class="text-center mb-4">Ubicación</h2>
        <div id="map"></div>
    </section>